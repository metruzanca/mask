# Automatic per-repository switching, shown by a Starship prompt.
Output docs/gifs/auto-switch.gif
Set Shell bash
Set FontFamily "FiraCode Nerd Font"
Set FontSize 17
Set Width 1100
Set Height 280
Set Padding 24
Set Theme "Catppuccin Mocha"
Set TypingSpeed 50ms
Set CursorBlink false

Hide
Type 'source docs/vhs/demo.sh'
Enter
Sleep 500ms
Type 'clear'
Enter
Sleep 300ms
Show
Sleep 500ms

Type 'cd dev/huddlesurety'
Enter
Sleep 1600ms

Type 'cd ../fuelmap'
Enter
Sleep 1600ms

Type 'cd ..'
Enter
Sleep 1400ms

Type 'cd huddlesurety'
Enter
Sleep 1800ms
